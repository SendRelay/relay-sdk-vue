{
  "name": "@relay-sdk/vue",
  "version": "1.7.0",
  "description": "Official Relay Vue bindings - track a delivery live with one composable",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm run clean && rollup -c",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "keywords": [
    "relay",
    "delivery",
    "tracking",
    "realtime",
    "vue",
    "nuxt",
    "composable"
  ],
  "author": "SendRelay",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SendRelay/relay-sdk-vue.git"
  },
  "homepage": "https://docs.sendrelay.com.ng/sdks/vue-sdk",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@relay-sdk/sdk-browser": "^1.7.0"
  },
  "peerDependencies": {
    "vue": ">=3.3.0"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^29.1.1",
    "rollup": "^4.60.4",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vitest": "4.1.11",
    "vue": "^3.5.0"
  }
}
